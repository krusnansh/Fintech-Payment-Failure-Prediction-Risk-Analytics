            <FormulaField expression="IF [amount] &lt;= 0 THEN 1 ELSE 0 ENDIF" field="invalid_amount_flag" size="4" type="Int32" enabled="true" />
            <FormulaField expression="IF IsNull([email]) OR [email] = &quot;&quot; OR NOT RegEx_Match([email], &quot;^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$&quot;) THEN 1 ELSE 0 ENDIF" field="invalid_email_flag" size="4" type="Int32" enabled="true" />
