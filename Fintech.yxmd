            <FormulaField expression="IF IsNull([pan_number]) OR [pan_number] = &quot;&quot; OR NOT RegEx_Match(UpperCase([pan_number]), &quot;^[A-Z]{5}[0-9]{4}[A-Z]$&quot;) THEN 1 ELSE 0 ENDIF" field="invalid_pan_flag" size="8" type="Int64" enabled="true" />
            <FormulaField expression="IF IsNull([billing_pincode]) OR [billing_pincode] = &quot;&quot; OR NOT RegEx_Match([billing_pincode], &quot;^[0-9]{6}$&quot;) THEN 1 ELSE 0 ENDIF" field="invalid_pincode_flag" size="8" type="Int64" enabled="true" />
            <FormulaField expression="IF IsNull([ip_address]) OR [ip_address] = &quot;&quot; OR NOT RegEx_Match([ip_address], &quot;^([0-9]{1,3}\.){3}[0-9]{1,3}$&quot;) THEN 1 ELSE 0 ENDIF" field="invalid_ip_flag" size="8" type="Int64" enabled="true" />
            <FormulaField expression="IF&#xA;    ([payment_status] = &quot;Success&quot; AND !IsNull([failure_reason]) AND [failure_reason] != &quot;&quot;)&#xA;    OR&#xA;    ([payment_status] = &quot;Success&quot; AND [response_code] != &quot;00&quot;)&#xA;    OR&#xA;    ([payment_status] = &quot;Failed&quot; AND (IsNull([failure_reason]) OR [failure_reason] = &quot;&quot;))&#xA;THEN 1&#xA;ELSE 0&#xA;ENDIF" field="business_rule_exception_flag" size="8" type="Int64" enabled="true" />
          </FormulaFields>
        </Configuration>
